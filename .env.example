# Local development values. Railway injects MYSQL* variables for its MySQL service.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dcs_research
DB_PORT=3306

# Comma-separated exact browser origins allowed to call this API.
CLIENT_ORIGINS=http://localhost:5173

# Optional. On Railway, mount a Volume at this exact path to persist uploaded PDFs.
# UPLOADS_DIR=/app/uploads
